@implements IDisposable
@inject CurrentUserState User

<header class="sticky top-0 z-40 border-b border-ink/10 bg-white/95 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3" aria-label="Main">
        <BrandLogo />

        <ul class="hidden items-center gap-7 md:flex">
            @foreach (var item in VisibleLinks)
            {
                <li>
                    <NavLink href="@item.Href"
                             Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                             class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                             ActiveClass="!font-bold !text-brand-600">
                        @item.Text
                    </NavLink>
                </li>
            }
        </ul>

        <div class="hidden items-center gap-3 md:flex">
            @if (User.IsAuthenticated)
            {
                <AppBadge Variant="BadgeVariant.Brand">@User.Role</AppBadge>
                <AppButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="LogOut">Log out</AppButton>
            }
            else
            {
                <AppButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="/login">Log in</AppButton>
                <AppButton Size="ButtonSize.Small" Href="/start">Get started</AppButton>
            }
        </div>

        <button type="button"
                class="-mr-2 rounded-lg p-2 text-ink hover:bg-ink/5 md:hidden"
                aria-label="Toggle menu"
                aria-expanded="@(_menuOpen ? "true" : "false")"
                aria-controls="mobile-menu"
                @onclick="() => _menuOpen = !_menuOpen">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                @if (_menuOpen)
                {
                    <path d="M6 6l12 12M18 6L6 18" />
                }
                else
                {
                    <path d="M4 7h16M4 12h16M4 17h16" />
                }
            </svg>
        </button>
    </nav>

    @if (_menuOpen)
    {
        <div id="mobile-menu" class="border-t border-ink/10 bg-white px-4 pb-5 pt-2 md:hidden">
            <ul class="space-y-1">
                @foreach (var item in VisibleLinks)
                {
                    <li>
                        <NavLink href="@item.Href"
                                 Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                 class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                 ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                 @onclick="CloseMenu">
                            @item.Text
                        </NavLink>
                    </li>
                }
            </ul>

            <div class="mt-4 flex flex-col gap-3">
                @if (User.IsAuthenticated)
                {
                    <AppButton Variant="ButtonVariant.Outline" FullWidth="true" OnClick="LogOut">Log out (@User.Role)</AppButton>
                }
                else
                {
                    <AppButton FullWidth="true" Href="/start">Get started</AppButton>
                    <AppButton Variant="ButtonVariant.Outline" FullWidth="true" Href="/login">Log in</AppButton>
                }
            </div>
        </div>
    }
</header>

@code {
    private bool _menuOpen;

    private static readonly UserRole[] Authed = [UserRole.Requester, UserRole.Donor, UserRole.Moderator, UserRole.Admin];

    private static readonly NavLinkItem[] Links =
    [
        new("Home", "/", ExactMatch: true),
        new("How it works", "/#how-it-works", [UserRole.Guest]),
        new("About", "/about", [UserRole.Guest]),
        new("FAQ", "/faq", [UserRole.Guest]),

        new("My requests", "/requester", [UserRole.Requester]),
        new("New request", "/requester/new", [UserRole.Requester]),

        new("Dashboard", "/donor", [UserRole.Donor]),
        new("Donation history", "/donor/history", [UserRole.Donor]),

        new("Review queue", "/moderator", [UserRole.Moderator, UserRole.Admin]),
        new("Moderators", "/admin/moderators", [UserRole.Admin]),
    ];

    private IEnumerable<NavLinkItem> VisibleLinks => Links.Where(l => l.IsVisibleTo(User.Role));

    protected override void OnInitialized() => User.Changed += OnUserChanged;

    private void OnUserChanged() => _ = InvokeAsync(StateHasChanged);

    private void CloseMenu() => _menuOpen = false;

    private void LogOut()
    {
        _menuOpen = false;
        User.Clear();
    }

    public void Dispose() => User.Changed -= OnUserChanged;
}
