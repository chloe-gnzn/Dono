@inject AuthService AuthService
@inject NavigationManager Nav

<header class="sticky top-0 z-40 border-b border-ink/10 bg-white/95 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3" aria-label="Main">
        <BrandLogo />

        @* Desktop links *@
        <ul class="hidden items-center gap-7 md:flex">
            <li>
                <NavLink href="/"
                         Match="NavLinkMatch.All"
                         class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                         ActiveClass="!font-bold !text-brand-600">
                    Home
                </NavLink>
            </li>

            <AuthorizeView>
                <NotAuthorized>
                    <li>
                        <NavLink href="/#how-it-works"
                                 class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                                 ActiveClass="!font-bold !text-brand-600">
                            How it works
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/about"
                                 class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                                 ActiveClass="!font-bold !text-brand-600">
                            About
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/faq"
                                 class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                                 ActiveClass="!font-bold !text-brand-600">
                            FAQ
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>

            <AuthorizeView Policy="@AuthPolicies.RequesterOnly">
                <li>
                    <NavLink href="/requester"
                             class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                             ActiveClass="!font-bold !text-brand-600">
                        My requests
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/requester/new"
                             class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                             ActiveClass="!font-bold !text-brand-600">
                        New request
                    </NavLink>
                </li>
            </AuthorizeView>

            <AuthorizeView Policy="@AuthPolicies.DonorOnly">
                <li>
                    <NavLink href="/donor"
                             class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                             ActiveClass="!font-bold !text-brand-600">
                        Dashboard
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/donor/history"
                             class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                             ActiveClass="!font-bold !text-brand-600">
                        Donation history
                    </NavLink>
                </li>
            </AuthorizeView>

            <AuthorizeView Policy="@AuthPolicies.ModeratorOnly">
                <li>
                    <NavLink href="/moderator"
                             class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                             ActiveClass="!font-bold !text-brand-600">
                        Review queue
                    </NavLink>
                </li>
            </AuthorizeView>

            <AuthorizeView Policy="@AuthPolicies.AdminOnly">
                <li>
                    <NavLink href="/admin/moderators"
                             class="text-sm font-medium text-ink-soft transition-colors hover:text-brand-600"
                             ActiveClass="!font-bold !text-brand-600">
                        Moderators
                    </NavLink>
                </li>
            </AuthorizeView>
        </ul>

        @* Desktop actions *@
        <div class="hidden items-center gap-3 md:flex">
            <AuthorizeView>
                <Authorized>
                    @if (!string.IsNullOrWhiteSpace(context.User.Identity?.Name))
                    {
                        <span class="text-sm font-medium text-ink-soft">@context.User.Identity.Name</span>
                    }
                    <AppBadge Variant="BadgeVariant.Brand">@AuthPolicies.GetRole(context.User)</AppBadge>
                    <AppButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="LogOutAsync">Log out</AppButton>
                </Authorized>
                <NotAuthorized>
                    <AppButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="/login">Log in</AppButton>
                    <AppButton Size="ButtonSize.Small" Href="/register">Get started</AppButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        @* Mobile menu button *@
        <button type="button"
                class="-mr-2 rounded-lg p-2 text-ink hover:bg-ink/5 md:hidden"
                aria-label="Toggle menu"
                aria-expanded="@(_menuOpen ? "true" : "false")"
                aria-controls="mobile-menu"
                @onclick="() => _menuOpen = !_menuOpen">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                @if (_menuOpen)
                {
                    <path d="M6 6l12 12M18 6L6 18" />
                }
                else
                {
                    <path d="M4 7h16M4 12h16M4 17h16" />
                }
            </svg>
        </button>
    </nav>

    @* Mobile panel *@
    @if (_menuOpen)
    {
        <div id="mobile-menu" class="border-t border-ink/10 bg-white px-4 pb-5 pt-2 md:hidden">
            <ul class="space-y-1">
                <li>
                    <NavLink href="/"
                             Match="NavLinkMatch.All"
                             class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                             ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                             @onclick="CloseMenu">
                        Home
                    </NavLink>
                </li>

                <AuthorizeView>
                    <NotAuthorized>
                        <li>
                            <NavLink href="/#how-it-works"
                                     class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                     ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                     @onclick="CloseMenu">
                                How it works
                            </NavLink>
                        </li>
                        <li>
                            <NavLink href="/about"
                                     class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                     ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                     @onclick="CloseMenu">
                                About
                            </NavLink>
                        </li>
                        <li>
                            <NavLink href="/faq"
                                     class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                     ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                     @onclick="CloseMenu">
                                FAQ
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

                <AuthorizeView Policy="@AuthPolicies.RequesterOnly">
                    <li>
                        <NavLink href="/requester"
                                 class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                 ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                 @onclick="CloseMenu">
                            My requests
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/requester/new"
                                 class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                 ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                 @onclick="CloseMenu">
                            New request
                        </NavLink>
                    </li>
                </AuthorizeView>

                <AuthorizeView Policy="@AuthPolicies.DonorOnly">
                    <li>
                        <NavLink href="/donor"
                                 class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                 ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                 @onclick="CloseMenu">
                            Dashboard
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/donor/history"
                                 class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                 ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                 @onclick="CloseMenu">
                            Donation history
                        </NavLink>
                    </li>
                </AuthorizeView>

                <AuthorizeView Policy="@AuthPolicies.ModeratorOnly">
                    <li>
                        <NavLink href="/moderator"
                                 class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                 ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                 @onclick="CloseMenu">
                            Review queue
                        </NavLink>
                    </li>
                </AuthorizeView>

                <AuthorizeView Policy="@AuthPolicies.AdminOnly">
                    <li>
                        <NavLink href="/admin/moderators"
                                 class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-brand-50"
                                 ActiveClass="!bg-brand-50 !font-bold !text-brand-600"
                                 @onclick="CloseMenu">
                            Moderators
                        </NavLink>
                    </li>
                </AuthorizeView>
            </ul>

            <div class="mt-4 flex flex-col gap-3">
                <AuthorizeView>
                    <Authorized>
                        <AppButton Variant="ButtonVariant.Outline" FullWidth="true" OnClick="LogOutAsync">
                            Log out (@AuthPolicies.GetRole(context.User))
                        </AppButton>
                    </Authorized>
                    <NotAuthorized>
                        <AppButton FullWidth="true" Href="/register">Get started</AppButton>
                        <AppButton Variant="ButtonVariant.Outline" FullWidth="true" Href="/login">Log in</AppButton>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    }
</header>

@code {
    private bool _menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private async Task LogOutAsync()
    {
        _menuOpen = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/");
    }
}
