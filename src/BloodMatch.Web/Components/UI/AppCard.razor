<section class="@CssClass" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Title) || HeaderContent is not null)
    {
        <header class="border-b border-ink/10 px-6 py-4">
            @if (!string.IsNullOrEmpty(Title))
            {
                <h3 class="!text-lg">@Title</h3>
            }
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="mt-0.5 text-sm text-ink-soft">@Subtitle</p>
            }
            @HeaderContent
        </header>
    }

    <div class="@(NoPadding ? "" : "p-6")">
        @ChildContent
    </div>

    @if (FooterContent is not null)
    {
        <footer class="rounded-b-2xl border-t border-ink/10 bg-ink/[0.03] px-6 py-4">
            @FooterContent
        </footer>
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public bool Offset { get; set; }

    [Parameter] public bool NoPadding { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Offset ? "card-offset" : "card";
}
