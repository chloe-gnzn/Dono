@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-end justify-center p-4 sm:items-center"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@_titleId"
         tabindex="-1"
         @onkeydown="HandleKeyDown">

        <div class="absolute inset-0 bg-ink/60" @onclick="BackdropClick" aria-hidden="true"></div>

        <div class="relative w-full max-w-lg rounded-2xl bg-white shadow-2xl">
            <header class="flex items-start justify-between gap-4 border-b border-ink/10 px-6 py-4">
                <h2 id="@_titleId" class="!text-xl">@Title</h2>
                <button type="button" class="-m-1 rounded p-1 text-2xl leading-none text-ink-soft hover:text-ink" aria-label="Close dialog" @onclick="CloseAsync">&times;</button>
            </header>

            <div class="max-h-[60vh] overflow-y-auto px-6 py-5 text-sm text-ink-soft">
                @ChildContent
            </div>

            @if (FooterContent is not null)
            {
                <footer class="flex flex-wrap justify-end gap-3 rounded-b-2xl border-t border-ink/10 bg-ink/[0.03] px-6 py-4">
                    @FooterContent
                </footer>
            }
        </div>
    </div>
}

@code {
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    public Task CloseAsync() => IsOpenChanged.InvokeAsync(false);

    private Task BackdropClick() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    private Task HandleKeyDown(KeyboardEventArgs e) =>
        e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
