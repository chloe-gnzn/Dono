<span role="status" class="inline-flex items-center gap-2">
    <svg class="@SizeClass animate-spin @ColorClass" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path>
    </svg>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="text-sm text-ink-soft">@Label</span>
    }
    else
    {
        <span class="sr-only">Loading</span>
    }
</span>

@code {
    [Parameter] public SpinnerSize Size { get; set; } = SpinnerSize.Medium;

    /// <summary>Use on dark/red backgrounds (white spinner).</summary>
    [Parameter] public bool Light { get; set; }

    /// <summary>Optional visible text next to the spinner.</summary>
    [Parameter] public string? Label { get; set; }

    private string SizeClass => Size switch
    {
        SpinnerSize.Small => "h-4 w-4",
        SpinnerSize.Large => "h-10 w-10",
        _ => "h-6 w-6"
    };

    private string ColorClass => Light ? "text-white" : "text-brand-600";
}
