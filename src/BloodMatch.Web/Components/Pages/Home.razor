@page "/"

<PageTitle>BloodMatch</PageTitle>

<div class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <AppCard Offset="true" NoPadding="true">
        <div class="grid items-center gap-8 p-8 md:grid-cols-2 md:p-14">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-brand-600">Non-commercial blood matching</p>
                <h1 class="mt-3">Connecting families with <span class="text-brand-600">willing donors</span></h1>
                <p class="mt-5 max-w-md text-ink-soft">
                    Post a verified blood request, or sign up to donate. Patient identities stay private,
                    and every request is reviewed by a trusted moderator before donors are notified.
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                    <AppButton Href="/start/requester">I need blood</AppButton>
                    <AppButton Variant="ButtonVariant.Outline" Href="/start/donor">I want to donate</AppButton>
                </div>
                <p class="form-hint">These buttons lead to pages built in the next phases.</p>
            </div>

            <div class="flex justify-center" aria-hidden="true">
                <svg class="h-56 w-56 md:h-72 md:w-72" viewBox="0 0 32 32">
                    <circle cx="16" cy="16" r="16" fill="#FDE2E1" />
                    <path d="M16 5c3.6 4.6 7.2 8.3 7.2 12.4a7.2 7.2 0 0 1-14.4 0C8.8 13.3 12.4 9.6 16 5z" fill="#F44336" />
                    <path d="M16 5c3.6 4.6 7.2 8.3 7.2 12.4a7.2 7.2 0 0 1-7.2 7.2z" fill="#D32F2F" />
                    <rect x="15" y="13.8" width="2" height="7.6" rx=".3" fill="#fff" />
                    <rect x="12.2" y="16.6" width="7.6" height="2" rx=".3" fill="#fff" />
                </svg>
            </div>
        </div>
    </AppCard>

    @if (Env.IsDevelopment())
    {
        <p class="mt-6 text-center text-sm text-ink-soft">
            Developer tools:
            <a class="link" href="dev/components">UI components</a> &middot;
            <a class="link" href="dev/palette">Palette</a>
        </p>
    }
</div>

@code {
    [Inject] private IWebHostEnvironment Env { get; set; } = default!;
}
