@page "/not-found"

<PageTitle>Page not found</PageTitle>

<div class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="font-heading text-7xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 !text-3xl">Page not found</h1>
    <p class="mt-3 text-ink-soft">The page you are looking for does not exist, or has not been built yet.</p>
    <div class="mt-8">
        <AppButton Href="/">Back to home</AppButton>
    </div>
</div>
