@page "/forgot-password"
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Reset password - BloodMatch</PageTitle>

<div class="mx-auto max-w-md px-4 py-14">
    <AppCard Offset="true"
             Title="@(_isRecoveryMode ? "Set a new password" : "Reset your password")"
             Subtitle="@(_isRecoveryMode ? "Enter a strong new password for your account." : "We will email you a secure password recovery link.")">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mb-5">
                <AppAlert Variant="AlertVariant.Danger" Title="Request failed">@_error</AppAlert>
            </div>
        }

        @if (_isRecoveryMode)
        {
            if (_passwordUpdated)
            {
                <AppAlert Variant="AlertVariant.Success" Title="Password updated">
                    Your password has been changed. You can now sign in with your new password.
                </AppAlert>
                <div class="mt-6">
                    <AppButton Href="/login" FullWidth="true">Continue to login</AppButton>
                </div>
            }
            else
            {
                <EditForm Model="_resetModel" OnValidSubmit="UpdatePasswordAsync" FormName="reset-password-form">
                    <DataAnnotationsValidator />
                    <div class="space-y-4">
                        <FormField Label="New password" InputId="reset-pw" Required="true" Hint="At least 8 characters">
                            <InputText id="reset-pw" type="password" class="form-input" @bind-Value="_resetModel.NewPassword" />
                            <ValidationMessage For="() => _resetModel.NewPassword" />
                        </FormField>

                        <FormField Label="Confirm new password" InputId="reset-confirm" Required="true">
                            <InputText id="reset-confirm" type="password" class="form-input" @bind-Value="_resetModel.ConfirmPassword" />
                            <ValidationMessage For="() => _resetModel.ConfirmPassword" />
                        </FormField>

                        <AppButton Type="submit" FullWidth="true" Loading="_submitting">
                            @(_submitting ? "Updating..." : "Update password")
                        </AppButton>
                    </div>
                </EditForm>
            }
        }
        else if (_emailSent)
        {
            <AppAlert Variant="AlertVariant.Success" Title="Reset email sent">
                If an account exists for <strong>@_requestModel.Email</strong>, a recovery link has been sent to that inbox.
            </AppAlert>
            <div class="mt-6">
                <AppButton Variant="ButtonVariant.Outline" Href="/login" FullWidth="true">Back to login</AppButton>
            </div>
        }
        else
        {
            <EditForm Model="_requestModel" OnValidSubmit="SendResetEmailAsync" FormName="forgot-password-form">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <FormField Label="Email address" InputId="forgot-email" Required="true">
                        <InputText id="forgot-email" type="email" class="form-input" @bind-Value="_requestModel.Email" placeholder="you@example.com" />
                        <ValidationMessage For="() => _requestModel.Email" />
                    </FormField>

                    <AppButton Type="submit" FullWidth="true" Loading="_submitting">
                        @(_submitting ? "Sending link..." : "Send reset link")
                    </AppButton>

                    <p class="text-center text-xs text-ink-soft">
                        Remembered it? <a class="link" href="/login">Back to login</a>
                    </p>
                </div>
            </EditForm>
        }
    </AppCard>
</div>

@code {
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [SupplyParameterFromQuery(Name = "token_hash")]
    public string? TokenHash { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? Type { get; set; }

    private readonly ForgotPasswordInput _requestModel = new();
    private readonly ResetPasswordInput _resetModel = new();

    private bool _submitting;
    private bool _emailSent;
    private bool _isRecoveryMode;
    private bool _passwordUpdated;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (string.Equals(Mode, "recovery", StringComparison.OrdinalIgnoreCase))
        {
            _isRecoveryMode = true;
            StateHasChanged();
            return;
        }

        if (!string.IsNullOrWhiteSpace(TokenHash))
        {
            var result = await AuthService.VerifyTokenHashAsync(TokenHash, Type ?? "recovery");
            if (result.Succeeded)
            {
                _isRecoveryMode = true;
            }
            else
            {
                _error = result.ErrorMessage;
            }

            StateHasChanged();
        }
    }

    private async Task SendResetEmailAsync()
    {
        _error = null;
        _submitting = true;

        try
        {
            var redirectUrl = Nav.ToAbsoluteUri("/auth/confirm").ToString();
            var result = await AuthService.SendPasswordResetAsync(_requestModel.Email, redirectUrl);
            if (!result.Succeeded)
            {
                _error = result.ErrorMessage;
                return;
            }

            _emailSent = true;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task UpdatePasswordAsync()
    {
        _error = null;
        _submitting = true;

        try
        {
            var result = await AuthService.UpdatePasswordAsync(_resetModel.NewPassword);
            if (!result.Succeeded)
            {
                _error = result.ErrorMessage;
                return;
            }

            _passwordUpdated = true;
        }
        finally
        {
            _submitting = false;
        }
    }
}
